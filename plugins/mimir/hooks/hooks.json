{
  "description": "Vincoli automatici di Mímir",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "shell": "bash", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-python.sh\" --fail-closed \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/git-guard.py\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "shell": "bash", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/handoff.py\"", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "shell": "bash", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/retro-nudge.py\"", "timeout": 5 },
          { "type": "command", "shell": "bash", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/handoff.py\"", "timeout": 5 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "shell": "bash", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/maven-sandbox.py\"", "timeout": 5 }
        ]
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          { "type": "command", "shell": "bash", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/handoff.py\"", "timeout": 5 }
        ]
      }
    ]
  }
}
