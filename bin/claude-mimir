#!/usr/bin/env bash
# Avvia Claude Code con Mímir attivo solo per questa sessione:
# regole (CLAUDE.md di Mímir), plugin (skill, agent, hook letti da plugins/), sandbox,
# blocchi su commit/push/tag e attribuzioni.
# I plugin si caricano dalla cartella a ogni avvio: non serve installarli né aggiornarli.
# Se mimir@mimir o brokkr@mimir sono anche installati, tienili disabilitati: sarebbero una seconda copia.
# Uso:
#   claude-mimir [--add-dir <cartella> ...] [altri argomenti di claude]   sessione normale
#   claude-mimir agents [--add-dir <cartella> ...]                        agent view (sessioni in background)
set -euo pipefail
MIMIR_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD=1
# settings di Maven senza credenziali: quello personale non è leggibile nella sandbox
export MIMIR_MAVEN_SETTINGS="$MIMIR_DIR/sandbox/maven-settings.xml"
# passaggi di consegne tra sessioni (hook handoff.py, Ratatoskr): senza, l'hook non fa nulla.
# Fuori da Mímir perché la shell nella sandbox non ci deve scrivere: Claude li scrive con Write.
# Con -p/--print no, e si toglie anche se arriva dall'ambiente (un -p lanciato da una sessione del
# launcher): SessionStart archivierebbe il passaggio della cartella senza che nessuno lo veda.
# Un prompt uguale a "-p" spegne i passaggi per quel lancio: caso accettato.
handoff=1
for arg in "$@"; do
  if [[ "$arg" == "-p" || "$arg" == "--print" ]]; then
    handoff=0
  fi
done
if (( handoff )); then
  export MIMIR_HANDOFF_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/mimir/handoff"
else
  unset MIMIR_HANDOFF_DIR
fi
MIMIR_ARGS=(--settings "$MIMIR_DIR/sandbox.settings.json" --add-dir "$MIMIR_DIR" --plugin-dir "$MIMIR_DIR/plugins")

if [[ "${1:-}" == "agents" ]]; then
  shift
  exec claude agents "${MIMIR_ARGS[@]}" "$@"
fi
exec claude "${MIMIR_ARGS[@]}" "$@"
