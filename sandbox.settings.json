{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "skillListingBudgetFraction": 0.03,
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "filesystem": {
      "allowWrite": [
        "~/.m2/repository",
        "~/.m2/wrapper",
        "~/.npm/_cacache",
        "~/.npm/_logs",
        "~/.cache/yarn",
        "~/.local/share/pnpm",
        "~/.gradle/caches",
        "~/.gradle/wrapper"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.git-credentials",
          "mode": "deny"
        },
        {
          "path": "~/.aws/credentials",
          "mode": "deny"
        },
        {
          "path": "~/.claude/.credentials.json",
          "mode": "deny"
        },
        {
          "path": "~/.docker/config.json",
          "mode": "deny"
        },
        {
          "path": "~/.gnupg",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh/hosts.yml",
          "mode": "deny"
        },
        {
          "path": "~/.config/hub",
          "mode": "deny"
        }
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "repo.maven.apache.org",
        "repo1.maven.org",
        "oss.sonatype.org",
        "registry.npmjs.org",
        "*.npmjs.org",
        "registry.yarnpkg.com"
      ]
    },
    "failIfUnavailable": true
  },
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "Read(~/.ssh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.aws/credentials)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.m2/settings.xml)",
      "Read(~/.docker/config.json)",
      "Read(~/.gradle/gradle.properties)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.config/hub)",
      "Read(~/.claude.json)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(git pull:*)",
      "Bash(git am:*)",
      "Bash(git clean:*)",
      "Bash(git restore:*)",
      "Bash(git checkout:*)",
      "Bash(git update-ref:*)",
      "Bash(git filter-branch:*)",
      "Bash(git prune:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch --delete:*)",
      "Bash(git branch -M:*)",
      "Bash(git branch -f:*)",
      "Bash(git branch --force:*)",
      "Bash(git switch -f:*)",
      "Bash(git switch --force:*)",
      "Bash(git switch --discard-changes:*)",
      "Bash(git switch -C:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git reflog expire:*)",
      "Bash(git reflog delete:*)",
      "Bash(git reflog drop:*)",
      "Bash(git rm -f:*)",
      "Bash(git rm --force:*)",
      "Bash(git checkout-index -f:*)",
      "Bash(git checkout-index --force:*)",
      "Bash(git worktree remove:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git push:*)",
      "PowerShell(git tag:*)",
      "PowerShell(git reset:*)",
      "PowerShell(git rebase:*)",
      "PowerShell(git merge:*)",
      "PowerShell(git cherry-pick:*)",
      "PowerShell(git revert:*)",
      "PowerShell(git pull:*)",
      "PowerShell(git am:*)",
      "PowerShell(git clean:*)",
      "PowerShell(git restore:*)",
      "PowerShell(git checkout:*)",
      "PowerShell(git update-ref:*)",
      "PowerShell(git filter-branch:*)",
      "PowerShell(git prune:*)",
      "PowerShell(git branch -D:*)",
      "PowerShell(git branch -d:*)",
      "PowerShell(git branch --delete:*)",
      "PowerShell(git branch -M:*)",
      "PowerShell(git branch -f:*)",
      "PowerShell(git branch --force:*)",
      "PowerShell(git switch -f:*)",
      "PowerShell(git switch --force:*)",
      "PowerShell(git switch --discard-changes:*)",
      "PowerShell(git switch -C:*)",
      "PowerShell(git stash drop:*)",
      "PowerShell(git stash clear:*)",
      "PowerShell(git reflog expire:*)",
      "PowerShell(git reflog delete:*)",
      "PowerShell(git reflog drop:*)",
      "PowerShell(git rm -f:*)",
      "PowerShell(git rm --force:*)",
      "PowerShell(git checkout-index -f:*)",
      "PowerShell(git checkout-index --force:*)",
      "PowerShell(git worktree remove:*)",
      "Bash(gh:*)",
      "Bash(hub:*)",
      "PowerShell(gh:*)",
      "PowerShell(hub:*)",
      "Bash(dangerouslyDisableSandbox:true)"
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  }
}
